    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Playground Tabs
        function switchTab(tab) {
            ['chat', 'code', 'image'].forEach(t => {
                document.getElementById(`content-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).classList.remove('border-b-2', 'border-blue-500', 'bg-white/5', 'text-white');
                document.getElementById(`tab-${t}`).classList.add('text-gray-400');
            });
            document.getElementById(`content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).classList.add('border-b-2', 'border-blue-500', 'bg-white/5', 'text-white');
            document.getElementById(`tab-${tab}`).classList.remove('text-gray-400');
        }

        // Chat Playground Simulation
        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const container = document.getElementById('chat-messages');
            if(!input.value.trim()) return;

            // User message
            container.innerHTML += `
                <div class="flex items-start gap-3 justify-end">
                    <div class="bg-blue-600/30 border border-blue-500/30 p-4 rounded-xl text-sm text-white max-w-[80%]">${input.value}</div>
                    <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center text-xs shrink-0 font-bold">U</div>
                </div>
            `;
            const userQuery = input.value;
            input.value = '';
            container.scrollTop = container.scrollHeight;

            // Simulated AI Response
            setTimeout(() => {
                container.innerHTML += `
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-lg gradient-bg text-white flex items-center justify-center text-xs shrink-0 font-bold">AI</div>
                        <div class="glass-card p-4 rounded-xl text-sm text-gray-200 max-w-[80%]">
                            Analyzing prompt: "<em>${userQuery}</em>". NovaAI neural network generated optimal response: Everything is operating at peak performance with zero latency. How else can I assist your engineering pipeline today?
                        </div>
                    </div>
                `;
                container.scrollTop = container.scrollHeight;
            }, 600);
        }

        // Code Generator Simulation
        function generateCode() {
            const lang = document.getElementById('code-lang').value;
            const prompt = document.getElementById('code-prompt').value || 'Default function';
            const output = document.getElementById('code-output');
            
            output.innerText = `// Generating ${lang.toUpperCase()} code for: "${prompt}"...\n\n`;
            let sampleCode = '';
            if(lang === 'python') {
                sampleCode = `def ${prompt.toLowerCase().replace(/[^a-z0-9]/g, '_')}(data_stream):\n    """NovaAI synthesized Python module."""\n    import time\n    start_time = time.time()\n    processed = [x * 2 for x in data_stream if x > 0]\n    print(f"Executed in {time.time() - start_time:.4f}s")\n    return processed`;
            } else if(lang === 'javascript') {
                sampleCode = `async function ${prompt.toLowerCase().replace(/[^a-z0-9]/g, '_')}(payload) {\n    // NovaAI Node.js asynchronous handler\n    console.log("Processing payload...", payload);\n    const result = await fetch('https://api.novaai.internal/v4/compute', {\n        method: 'POST',\n        body: JSON.stringify(payload)\n    });\n    return await result.json();\n}`;
            } else {
                sampleCode = `// TypeScript / Rust synthesized template\npub fn execute_neural_task(input: &str) -> Result<String, Box<dyn std::error::Error>> {\n    println!("Running NovaAI Rust kernel for: {}", input);\n    Ok("Success".to_string())\n}`;
            }

            let i = 0;
            const interval = setInterval(() => {
                output.innerText += sampleCode.charAt(i);
                i++;
                if(i >= sampleCode.length) clearInterval(interval);
            }, 10);
        }

        // Image Concept Simulation
        function generateImageConcept() {
            const placeholder = document.getElementById('image-placeholder');
            const result = document.getElementById('image-result');
            placeholder.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-3xl mb-2 text-blue-400 block"></i> Synthesizing neural concept pixels...`;
            setTimeout(() => {
                placeholder.innerHTML = '';
                result.classList.remove('hidden');
            }, 1200);
        }

        // Pricing Billing Toggle
        function setBilling(type) {
            const btnM = document.getElementById('btn-monthly');
            const btnY = document.getElementById('btn-yearly');
            const pStarter = document.getElementById('price-starter');
            const pPro = document.getElementById('price-pro');
            const pEnt = document.getElementById('price-enterprise');

            if(type === 'monthly') {
                btnM.className = "px-5 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-all";
                btnY.className = "px-5 py-2 rounded-lg text-sm font-semibold text-gray-400 hover:text-white transition-all";
                pStarter.innerText = "$0";
                pPro.innerText = "$29";
                pEnt.innerText = "$199";
            } else {
                btnY.className = "px-5 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-all";
                btnM.className = "px-5 py-2 rounded-lg text-sm font-semibold text-gray-400 hover:text-white transition-all";
                pStarter.innerText = "$0";
                pPro.innerText = "$23";
                pEnt.innerText = "$159";
            }
        }

        // FAQ Accordion Toggle
        function toggleFaq(id) {
            const content = document.getElementById(`faq-content-${id}`);
            const icon = document.getElementById(`faq-icon-${id}`);
            content.classList.toggle('hidden');
            icon.classList.toggle('rotate-45');
        }

        // Floating Chatbot Widget Toggle
        function toggleChatWidget() {
            const box = document.getElementById('chat-widget-box');
            box.classList.toggle('hidden');
        }

        function handleWidgetSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('widget-input');
            const container = document.getElementById('widget-messages');
            if(!input.value.trim()) return;

            container.innerHTML += `
                <div class="flex items-start gap-2 justify-end">
                    <div class="bg-blue-600/30 border border-blue-500/30 p-2.5 rounded-lg text-white">${input.value}</div>
                </div>
            `;
            const q = input.value;
            input.value = '';
            container.scrollTop = container.scrollHeight;

            setTimeout(() => {
                container.innerHTML += `
                    <div class="flex items-start gap-2">
                        <div class="w-6 h-6 rounded bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold shrink-0">AI</div>
                        <div class="bg-white/5 p-2.5 rounded-lg text-gray-200">Thanks for asking about "${q}". Our team can help you set this up instantly! Feel free to start a free trial.</div>
                    </div>
                `;
                container.scrollTop = container.scrollHeight;
            }, 600);
        }

        // Auth Modal Control
        function openModal(type) {
            const modal = document.getElementById('auth-modal');
            const title = document.getElementById('modal-title');
            const subtitle = document.getElementById('modal-subtitle');
            const nameField = document.getElementById('name-field');
            const submitBtn = document.getElementById('modal-submit-btn');

            modal.classList.remove('hidden');
            modal.classList.add('flex');

            if(type === 'signup') {
                title.innerText = "Create Your Account";
                subtitle.innerText = "Get started with NovaAI free trial today.";
                nameField.classList.remove('hidden');
                submitBtn.innerText = "Create Account";
            } else {
                title.innerText = "Welcome Back";
                subtitle.innerText = "Sign in to your NovaAI developer account.";
                nameField.classList.add('hidden');
                submitBtn.innerText = "Sign In";
            }
        }

        function closeModal() {
            const modal = document.getElementById('auth-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            alert('Authentication simulation successful! Redirecting to workspace...');
            closeModal();
        }
    </script>
</body>
</html>